#!/bin/sh /etc/rc.common
# procd service for uvcstream (USB webcam -> MJPEG over HTTP, userspace UVC)

START=99
USE_PROCD=1

start_service() {
	config_load uvcstream
	local port width height fps device
	config_get port main port 8081
	config_get width main width 1280
	config_get height main height 720
	config_get fps main fps 15
	config_get device main device ""

	procd_open_instance
	procd_set_param command /usr/bin/uvcstream -p "$port" -W "$width" -H "$height" -f "$fps"
	[ -n "$device" ] && procd_append_param command -d "$device"
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
